{
  "$schema": "./node_modules/syncpack/schema.json",
  "source": [
    "package.json",
    "packages/*/package.json",
    "apps/*/package.json",
    "apps/*/*/package.json",
    "e2e/fixtures/*/package.json",
    "!**/dist/**",
    "!**/templates/**"
  ],
  "versionGroups": [
    {
      "label": "Chat SDK declarations and consumers must use matching versions",
      "dependencies": ["chat", "@chat-adapter/*"],
      "dependencyTypes": ["dev", "prod"]
    },
    {
      "label": "Extensions declare a broad kaf peer range",
      "dependencies": ["kaf"],
      "packages": [
        "kaf-code",
        "gadget-extension",
        "gizmo-extension",
        "js-only-extension",
        "toolkit-extension"
      ],
      "dependencyTypes": ["peer"],
      "isIgnored": true
    },
    {
      "label": "Separately published kaf packages accept compatible kaf patch releases",
      "dependencies": ["kaf"],
      "packages": ["@kaf/buzz-acp-adapter"],
      "dependencyTypes": ["prod"],
      "pinVersion": "workspace:^"
    },
    {
      "label": "Blooio is an externally published integration",
      "dependencies": ["kaf-channel-blooio"],
      "packages": ["kaf-docs"],
      "dependencyTypes": ["dev"],
      "isIgnored": true
    },
    {
      "label": "Workspace packages must use the workspace: protocol",
      "dependencies": ["kaf-*", "kaf"],
      "dependencyTypes": ["dev", "prod", "peer"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "kaf host peer ranges are intentionally broad",
      "dependencies": ["next", "react"],
      "packages": ["kaf"],
      "dependencyTypes": ["peer"],
      "isIgnored": true
    },
    {
      "label": "Projects that need the TypeScript compiler API pin TypeScript 6",
      "dependencies": ["typescript"],
      "packages": [
        "kaf-docs",
        "framework-next",
        "framework-next-multi-agent",
        "framework-nuxt",
        "web-chat-next-template"
      ],
      "dependencyTypes": ["dev"],
      "pinVersion": "6.0.3"
    },
    {
      "label": "Extension fixtures consumed via file: cannot use the catalog protocol",
      "dependencies": ["zod"],
      "packages": ["gadget-extension", "gizmo-extension"],
      "dependencyTypes": ["prod"],
      "pinVersion": "4.5.4"
    },
    {
      "label": "Shared third-party deps must use the catalog: protocol",
      "policy": "catalog",
      "dependencies": [
        "@opentelemetry/core",
        "@opentelemetry/sdk-trace-base",
        "@types/node",
        "@types/react",
        "@types/react-dom",
        "@vercel/otel",
        "next",
        "picocolors",
        "react",
        "react-dom",
        "streamdown",
        "typescript",
        "vitest",
        "zod"
      ],
      "dependencyTypes": ["dev", "prod", "peer"]
    },
    {
      "label": "Other dependencies are not enforced",
      "dependencies": ["**"],
      "isIgnored": true
    }
  ]
}
