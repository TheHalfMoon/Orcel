{
  "name": "@orcel/computer-use",
  "version": "0.0.0",
  "private": true,
  "description": "Source of the orcel/computer-use extension: computer use in a Linux sandbox desktop, with the driver install and start helpers.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:scenario": "node --test \"test/scenario/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "orcel": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "typescript-compiler": "npm:typescript@6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "orcel": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  }
}
