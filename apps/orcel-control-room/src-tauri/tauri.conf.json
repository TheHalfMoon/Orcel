{
  "productName": "Orcel Control Room",
  "version": "0.1.0",
  "identifier": "ai.orcel.control-room",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Orcel Control Room",
        "url": "start.html",
        "create": false,
        "visible": false,
        "width": 960,
        "height": 640,
        "minWidth": 480,
        "minHeight": 320,
        "useHttpsScheme": true,
        "dragDropEnabled": false,
        "devtools": false,
        "zoomHotkeysEnabled": false,
        "browserExtensionsEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: https://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false
  }
}
