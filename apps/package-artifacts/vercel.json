{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter orcel-package-artifacts build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/pr/:ref/orcel.tgz", "destination": "/api/package?ref=:ref" },
    { "source": "/pr/:ref/latest.json", "destination": "/api/package?ref=:ref&manifest=1" },
    { "source": "/:ref/orcel.tgz", "destination": "/api/package?ref=:ref" },
    { "source": "/main/latest.json", "destination": "/api/package?ref=main&manifest=1" }
  ]
}
