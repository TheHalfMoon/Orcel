le":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/consumers/buy-store-serve-safe-food"},"style":{},"children":[{"kind":"text","text":"Buy, Store & Serve Safe Food","style":{}}]},{"kind":"el","tag":"ul","attrs":{},"style":{},"children":[{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/food-facts-consumers"},"style":{},"children":[{"kind":"text","text":"Food Facts for Consumers","style":{}}]}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/food-safety-your-kitchen"},"style":{},"children":[{"kind":"text","text":"Food Safety in Your Kitchen","style":{}}]}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/queso-fresco-type-cheeses-consumer-guidance"},"style":{},"children":[{"kind":"text","text":"Queso Fresco-type Cheeses Consumer Guidance","style":{}}]}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/5-red-flags-look-when-shopping-meal-kits"},"style":{},"children":[{"kind":"text","text":"5 Red Flags to Look For When Shopping for Meal Kits","style":{}}]}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/everyday-food-safety-young-adults"},"style":{},"children":[{"kind":"text","text":"Everyday Food Safety for Young Adults","style":{}}]}]}]}]}]}]}]},{"kind":"el","tag":"main","attrs":{},"style":{},"children":[{"kind":"el","tag":"article","attrs":{},"style":{},"children":[{"kind":"el","tag":"header","attrs":{},"style":{},"children":[{"kind":"el","tag":"h1","attrs":{},"style":{},"children":[{"kind":"text","text":"Safe Food Handling","style":{}}]}]},{"kind":"el","tag":"aside","attrs":{},"style":{},"children":[{"kind":"el","tag":"nav","attrs":{},"style":{},"children":[{"kind":"el","tag":"ul","attrs":{},"style":{},"children":[{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/consumers/buy-store-serve-safe-food"},"style":{},"children":[{"kind":"text","text":"Buy, Store & Serve Safe Food","style":{}}]},{"kind":"el","tag":"ul","attrs":{},"style":{},"children":[{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/food-facts-consumers"},"style":{},"children":[{"kind":"text","text":"Food Facts for Consumers","style":{}}]}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/food-safety-your-kitchen"},"style":{},"children":[{"kind":"text","text":"Food Safety in Your Kitchen","style":{}}]}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/queso-fresco-type-cheeses-consumer-guidance"},"style":{},"children":[{"kind":"text","text":"Queso Fresco-type Cheeses Consumer Guidance","style":{}}]}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/5-red-flags-look-when-shopping-meal-kits"},"style":{},"children":[{"kind":"text","text":"5 Red Flags to Look For When Shopping for Meal Kits","style":{}}]}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/everyday-food-safety-young-adults"},"style":{},"children":[{"kind":"text","text":"Everyday Food Safety for Young Adults","style":{}}]}]}]}]}]}]}]},{"kind":"el","tag":"div","attrs":{},"style":{},"children":[{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/media/91319/download"},"style":{},"children":[{"kind":"el","tag":"span","attrs":{},"style":{},"children":[{"kind":"text","text":"Print & Share (PDF)","style":{}}]}]}]},{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"el","tag":"a","attrs":{"href":"/food/buy-store-serve-safe-food/manipulacion-segura-de-los-alimentos-lo-que-usted-debe-saber"},"style":{},"children":[{"kind":"el","tag":"span","attrs":{},"style":{},"children":[{"kind":"text","text":"Español (Spanish)","style":{}}]}]}]},{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"text","text":"The food supply in the United States is among the safest in the world. However, when certain disease-causing bacteria or pathogens contaminate food, they can cause foodborne illness, often called “food poisoning.” The Federal government estimates that there are about 48 million cases of foodborne illness annually – the equivalent of sickening 1 in 6 Americans each year. And each year, these illnesses result in an estimated 128,000 hospitalizations and 3,000 deaths.","style":{}}]},{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"el","tag":"strong","attrs":{},"style":{},"children":[{"kind":"text","text":"Know the Symptoms","style":{}}]}]},{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"text","text":"Consuming dangerous foodborne bacteria will usually cause illness within 1 to 3 days of eating the contaminated food. However, sickness can also occur within 20 minutes or up to 6 weeks later. Symptoms of foodborne illness can include: vomiting, diarrhea, and abdominal pain – and flu-like symptoms, such as fever, headache, and body ache.","style":{}}]},{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"el","tag":"strong","attrs":{},"style":{},"children":[{"kind":"text","text":"Handle Foods Safely","style":{}}]}]},{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"text","text":"Although most healthy people will recover from a foodborne illness within a short period of time, some can develop chronic, severe, or even life-threatening health problems. In addition, some people are at a higher risk for developing foodborne illness, including pregnant women, young children, older adults, and people with weakened immune systems (such as transplant patients and individuals with HIV/AIDS, cancer, or diabetes). To keep your family safer from food poisoning,","style":{}},{"kind":"el","tag":"strong","attrs":{},"style":{},"children":[{"kind":"text","text":"follow these four simple steps: clean, separate, cook, and chill","style":{}}]},{"kind":"text","text":".","style":{}}]},{"kind":"el","tag":"h2","attrs":{},"style":{},"children":[{"kind":"text","text":"CLEAN","style":{}}]},{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"el","tag":"strong","attrs":{},"style":{},"children":[{"kind":"text","text":"Wash hands and surfaces often","style":{}}]}]},{"kind":"el","tag":"ul","attrs":{},"style":{},"children":[{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Wash your hands with warm water and soap for at least 20 seconds before and after handling food and after using the bathroom, changing diapers, and handling pets.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Wash your cutting boards, dishes, utensils, and counter tops with hot soapy water after preparing each food item.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Consider using paper towels to clean up kitchen surfaces. If you use cloth towels, launder them often in the hot cycle.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Rinse fresh fruits and vegetables under running tap water, including those with skins and rinds that are not eaten. Scrub firm produce with a clean produce brush.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"With canned goods, remember to clean lids before opening.","style":{}}]}]},{"kind":"el","tag":"h2","attrs":{},"style":{},"children":[{"kind":"text","text":"SEPARATE","style":{}}]},{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"el","tag":"strong","attrs":{},"style":{},"children":[{"kind":"text","text":"Separate raw meats from other foods","style":{}}]}]},{"kind":"el","tag":"ul","attrs":{},"style":{},"children":[{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Separate raw meat, poultry, seafood, and eggs from other foods in your grocery shopping cart, grocery bags, and refrigerator.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Use one cutting board for fresh produce and a separate one for raw meat, poultry, and seafood.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Never place cooked food on a plate that previously held raw meat, poultry, seafood, or eggs unless the plate has been washed in hot, soapy water.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Don’t reuse marinades used on raw foods unless you bring them to a boil first.","style":{}}]}]},{"kind":"el","tag":"h2","attrs":{},"style":{},"children":[{"kind":"text","text":"COOK","style":{}}]},{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"el","tag":"strong","attrs":{},"style":{},"children":[{"kind":"text","text":"Cook to the right temperature","style":{}}]}]},{"kind":"el","tag":"ul","attrs":{},"style":{},"children":[{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Color and texture are unreliable indicators of safety. Using a food thermometer is the only way to ensure the safety of meat, poultry, seafood, and egg products for all cooking methods. These foods must be cooked to a safe minimum internal temperature to destroy any harmful bacteria.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Cook eggs until the yolk and white are firm. Only use recipes in which eggs are cooked or heated thoroughly.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"When cooking in a microwave oven, cover food, stir, and rotate for even cooking. If there is no turntable, rotate the dish by hand once or twice during cooking. Always allow standing time, which completes the cooking, before checking the internal temperature with a food thermometer.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Bring sauces, soups and gravy to a boil when reheating.","style":{}}]}]},{"kind":"el","tag":"h2","attrs":{},"style":{},"children":[{"kind":"text","text":"CHILL","style":{}}]},{"kind":"el","tag":"p","attrs":{},"style":{},"children":[{"kind":"el","tag":"strong","attrs":{},"style":{},"children":[{"kind":"text","text":"Refrigerate foods promptly","style":{}}]}]},{"kind":"el","tag":"ul","attrs":{},"style":{},"children":[{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Use an appliance thermometer to be sure the temperature is consistently 40° F or below and the freezer temperature is 0° F or below.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Refrigerate or freeze meat, poultry, eggs, seafood, and other perishables within 2 hours of cooking or purchasing. Refrigerate within 1 hour if the temperature outside is above 90° F.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Never thaw food at room temperature, such as on the counter top. There are three safe ways to defrost food: in the refrigerator, in cold water, and in the microwave. Food thawed in cold water or in the microwave should be cooked immediately.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Always marinate food in the refrigerator.","style":{}}]},{"kind":"el","tag":"li","attrs":{},"style":{},"children":[{"kind":"text","text":"Divide large amounts of leftovers into shallow containers for quicker cooling in the refrigerator.","style":{}}]}]},{"kind":"el","tag":"h2","attrs":{},"style":{},"children":[{"kind":"text","text":"Safe Minimum Internal Temperatures","style":{}}]},{"kind":"el","tag":"table","attrs":{},"style":{},"children":[{"kind":"el","tag":"caption","attrs":{},"style":{},"children":[{"kind":"el","tag":"em","attrs":{},"style":{},"children":[{"kind":"el","tag":"strong","attrs":{},"style":{},"children":[{"kind":"text","text":"as measured with a food thermometer","style":{}}]}]}]},{"kind":"el","tag":"thead","attrs":{},"style":{},"children":[{"kind":"el","tag":"tr","attrs":{},"style":{},"children":[{"kind":"el","tag":"th","attrs":{},"style":{},"children":[{"kind":"text","text":"Food Type","style":{}}]},{"kind":"el","tag":"th","attrs":{},"style":{},"children":[{"kind":"text","text":"Internal temperature","style":{}}]}]}]},{"kind":"el","tag":"tbody","attrs":{},"style":{},"children":[{"kind":"el","tag":"tr","attrs":{},"style":{},"children":[{"kind":"el","tag":"td","attrs":{},"style":{},"children":[{"kind":"el","tag":"strong","attrs":{},"style":{},"children":[{"kind":"text","text":"Beef, Pork, Veal, and Lamb","style":{}}]},{"kind":"text","text":"(chops, roasts, steaks)","style":{}}]},{"kind":"el","tag":"td","attrs":{},"style":{},"children":[{"kind":"text","text":"145","style":{}},{"kind":"el","tag":"sup","attrs":{},"style":{},"children":[{"kind":"text","text":"o","style":{}}]},{"kind":"text","text":"F with a 3 minute rest time","style":{}}]}]},{"kind":"el","tag":"tr","attrs":{},"style":{},"children":[{"kind":"el","tag":"td","attrs":{},"style":{},"children":[{"kind":"el","tag":"strong","attrs":{},"style":{},"children":[{"kind":"text","text":"Ground Meat","style":{}}]}]},{"kind":"el","tag":"td","attrs":{},"style":{},"children":[{"kind":"text","text":"160","style":{}},{"kind":"el","tag":"sup","attrs":{},"style":{},"children":[{"kind":"text","text":"o","style":{}}]},{"kind":"text","text