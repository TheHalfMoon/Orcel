"tag": "p",
"children": [
"America the Beautiful Passes are",
{
"tag": "strong",
"children": [
"non-refundable, non-transferable and cannot be replaced if lost or stolen"
]
},
". Passholders must show valid photo identification (ID) with each pass."
]
},
{
"tag": "h4",
"children": [
"How to Get an America the Beautiful Pass"
]
},
{
"tag": "h5",
"children": [
"In Person (Recommended)"
]
},
{
"tag": "p",
"children": [
"Physical passes can be purchased or picked up at over 1,000 federal recreation sites."
]
},
{
"tag": "p",
"children": [
{
"tag": "a",
"href": "/planyourvisit/pickup-pass-locations.htm",
"children": [
"Purchase and pickup locations"
]
}
]
},
{
"tag": "h5",
"children": [
"Order Online, Receive by Mail"
]
},
{
"tag": "p",
"children": [
"To receive your pass by mail, order online at the",
{
"tag": "a",
"href": "https://store.usgs.gov",
"children": [
"USGS Online Store"
]
},
". Online orders are for physical passes, not digital passes, and may take up to three weeks to be processed and delivered. Order receipts may not be used in place of a physical pass. We recommend ordering at least three weeks in advance of your visit, or picking up a pass in person instead."
]
},
{
"tag": "h5",
"children": [
"Get a Digital Pass from Recreation.gov"
]
},
{
"tag": "p",
"children": [
"Skip the wait! Get a Digital America the Beautiful Pass through recreation.gov. Your digital pass can be saved to a mobile device and used immediately."
]
},
{
"tag": "p",
"children": [
{
"tag": "a",
"href": "https://www.recreation.gov/pass/",
"children": [
"Get a Digital America the Beautiful Pass"
]
}
]
}
]
},
