{
  "name": "agent-self-modification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e:prepare": "node scripts/prepare.mjs",
    "build": "pnpm run e2e:prepare && kaf build",
    "dev": "pnpm run e2e:prepare && kaf dev",
    "start": "kaf start",
    "typecheck": "pnpm run e2e:prepare && kaf build --skip-sandbox-prewarm && tsc",
    "test:e2e": "pnpm run e2e:prepare && kaf eval --strict",
    "test:scenario": "node --test test/*.scenario.test.mjs"
  },
  "dependencies": {
    "@kaf-e2e/config": "workspace:*",
    "@vercel/connect": "2.2.0",
    "@workflow/world-postgres": "catalog:",
    "kaf": "workspace:*",
    "just-bash": "3.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "e2e": {
    "worlds": [],
    "modelShards": [
      {
        "name": "repair",
        "evals": [
          "self-modification/offer-repair",
          "self-modification/repair-order-total"
        ]
      },
      {
        "name": "registry",
        "evals": [
          "self-modification/add-agent-browser",
          "self-modification/add-slack-channel"
        ]
      },
      {
        "name": "create",
        "evals": [
          "self-modification/create-shipping-quote",
          "self-modification/create-incident-triage"
        ]
      }
    ]
  }
}
