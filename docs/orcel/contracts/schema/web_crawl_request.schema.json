{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebCrawlRequest",
  "description": "A crawl or map run (one `orcel-jobs` unit), produced by `orcel-web` and\ntranslated by `orceld` into the browser host's crawl spec. Robots rules\nare always obeyed, so there is no field to turn them off.",
  "type": "object",
  "properties": {
    "contract": {
      "description": "`\"orcel.web-crawl/1\"`.",
      "type": "string"
    },
    "deadline_s": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "delay_ms": {
      "description": "Politeness delay, at least the budget's `min_delay_ms`.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "engine": {
      "$ref": "#/$defs/Engine"
    },
    "exclude_paths": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "extract": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "headers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/HeaderSpec"
      }
    },
    "include_paths": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "max_depth": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_pages": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "mode": {
      "$ref": "#/$defs/CrawlMode"
    },
    "privacy": {
      "$ref": "#/$defs/PrivacyProfileRef",
      "default": {
        "profile": "default",
        "sensitive": []
      }
    },
    "scope": {
      "$ref": "#/$defs/WebScope"
    },
    "search": {
      "description": "Map ranking (WI-02).",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "sitemap": {
      "$ref": "#/$defs/SitemapMode"
    },
    "start_url": {
      "type": "string"
    },
    "task": {
      "description": "Declared task, at most `MAX_TASK_BYTES`, escaped for prompts.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "mode",
    "start_url",
    "scope",
    "max_pages",
    "max_depth",
    "deadline_s",
    "sitemap",
    "engine",
    "delay_ms",
    "task"
  ],
  "$defs": {
    "CrawlMode": {
      "description": "Whether a crawl-shaped request is a crawl or a map run.",
      "type": "string",
      "enum": [
        "crawl",
        "map"
      ]
    },
    "Engine": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "fetch",
            "chromium"
          ]
        },
        {
          "description": "Track B.",
          "type": "string",
          "const": "obscura"
        }
      ]
    },
    "ExtractFormat": {
      "description": "Output formats Orcel produces in Wave 1 (section 5.3).",
      "type": "string",
      "enum": [
        "markdown",
        "html",
        "raw_html",
        "links",
        "change_tracking"
      ]
    },
    "ExtractRequest": {
      "type": "object",
      "properties": {
        "exclude_tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExtractFormat"
          }
        },
        "include_tags": {
          "description": "CSS selectors, at most `MAX_PATH_FILTERS`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "only_main_content": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "formats"
      ]
    },
    "HeaderSpec": {
      "description": "A custom request header (FD-UP-8 decided).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/HeaderValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ]
    },
    "HeaderValue": {
      "description": "A header value: a literal, or the name of a secret held in the OS secret\nstore and bound to its destination origins (section 4.12). On the wire:\n`{\"literal\": \"en\"}` or `{\"secret\": \"docs-token\"}`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "literal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "secret": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "secret"
          ]
        }
      ]
    },
    "PrivacyProfileRef": {
      "description": "The privacy profile a request runs under. `profile` names the\nprivacy-and-compatibility defaults (on by default, section 4.16);\n`sensitive` lists the opt-in features requested, empty by default.",
      "type": "object",
      "properties": {
        "profile": {
          "description": "`\"default\"` in Wave 1.",
          "type": "string"
        },
        "sensitive": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SensitiveFeature"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile"
      ]
    },
    "SensitiveFeature": {
      "description": "Sensitive, opt-in web features (section 4.16). Each is off unless the\nrequest names it, and each needs the client permission\n`web.privacy.sensitive:<feature>`. CAPTCHA solving, login, paywall or\naccess-control bypass and ignoring robots rules are never offered and\nhave no variant.",
      "type": "string",
      "enum": [
        "user_agent_override",
        "device_emulation",
        "locale_override",
        "timezone_override",
        "geolocation_override",
        "user_proxy",
        "fingerprint_randomisation",
        "tls_impersonation"
      ]
    },
    "SitemapMode": {
      "type": "string",
      "enum": [
        "include",
        "skip",
        "only"
      ]
    },
    "WebScope": {
      "description": "The destination scope a job's approval binds (section 4.11). Wave 1:\nexactly one origin (policy); Wave 2: a declared origin set. Origins are\nwritten `https://host[:port]`, lowercase, without a default port, path,\nquery, fragment or user info.",
      "type": "object",
      "properties": {
        "origins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "origins"
      ]
    }
  }
}
