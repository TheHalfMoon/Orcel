{
  "contract": "orcel.web-crawl/1",
  "mode": "crawl",
  "start_url": "https://docs.example.com/guide/",
  "scope": {
    "origins": [
      "https://docs.example.com"
    ]
  },
  "include_paths": [
    "^/guide/"
  ],
  "exclude_paths": [
    "^/guide/archive/"
  ],
  "max_pages": 50,
  "max_depth": 5,
  "deadline_s": 600,
  "sitemap": "include",
  "search": null,
  "extract": {
    "formats": [
      "markdown",
      "links"
    ],
    "only_main_content": true,
    "include_tags": [],
    "exclude_tags": [
      "nav"
    ]
  },
  "engine": "fetch",
  "delay_ms": 250,
  "headers": [
    {
      "name": "Accept-Language",
      "value": {
        "literal": "en"
      }
    },
    {
      "name": "Authorization",
      "value": {
        "secret": "docs-token"
      }
    }
  ],
  "privacy": {
    "profile": "default",
    "sensitive": [
      "locale_override"
    ]
  },
  "task": "Summarise the docs site"
}
